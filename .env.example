# Public Sanity configuration
NEXT_PUBLIC_SANITY_PROJECTID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_APIVERSION=2026-08-19

# Server-only Sanity credentials
SANITY_API_WRITE_TOKEN=
SANITY_WEBHOOK_SECRET=

# Clerk (use test keys in Preview and live keys in Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Maps browser key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe (use test keys in Preview and live keys in Production)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_MEMBERSHIP_PRICE_ID=
# Optional fallback when the product has exactly one active fixed price
STRIPE_MEMBERSHIP_PRODUCT_ID=

# Contact notifications
RESEND_API_KEY=
CONTACT_NOTIFICATION_FROM=
CONTACT_NOTIFICATION_TO=
